*.log
*.pyc
*.swp
*~
.venv
/.venv.backup-*
/.venv.tmp-*
lib/rucio/vcsversion.py

# Mac OS X Finder
.DS_Store

# Conveyor test files
tools/test.file.1G

# autotest logs/data
/.autotest
/.rucio-dev/

# JetBrains IDE
.idea/

# VSCode local state; keep the shared project configuration tracked
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Node.js dependencies for commitlint
node_modules/
package-lock.json

