etc/web/lighttpd*.conf
etc/alembic.ini
etc/ldap.cfg
etc/rucio-server-gcs.json
etc/globus-config.yml
alembic.ini
.gitlabkey
.githubtoken

# ignore test proxies
*.proxy
x509up*
demoCA
full.pem
proxy.pem
request.pem
usercert.pem
userkey.pem

# ignore MANIFEST file
